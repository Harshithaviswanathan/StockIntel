# Groq API (required)
GROQ_API_KEY=your_groq_api_key_here

# Persistent vector store (Docker volume mounts here)
VECTOR_DB_PATH=./data/new_vector_db
RAG_DATA_PATH=./data/rag_data

# Server
PORT=8000
DEBUG=False
LOG_LEVEL=INFO

# CORS — comma-separated frontend URLs (required in production)
# Docker local example:
# ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5174
ALLOWED_ORIGINS=*

# Optional
DEFAULT_LLM_MODEL=llama-3.1-8b-instant

# Full vector RAG (needs ~1GB+ RAM). Use true locally; Render free tier should be false.
ENABLE_RAG=true
